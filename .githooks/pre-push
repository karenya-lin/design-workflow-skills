#!/bin/sh
# Public identity guard, push side, for karenya-lin/design-workflow-skills.
#
# The pre-commit hook stops a wrong identity at commit time on this clone. This
# one checks what is about to become public: every commit the push would add
# to the remote is scanned for an author or committer email other than the
# approved GitHub noreply address. A commit made elsewhere, or before the hook
# was turned on, is caught here. See docs/PUBLIC-IDENTITY.md.
#
# Turn on once per clone: git config core.hooksPath .githooks
# Skip only when the owner has said so: SKIP_IDENTITY_GUARD=1 git push ...

APPROVED="99601006+karenya-lin@users.noreply.github.com"
ZERO="0000000000000000000000000000000000000000"

if [ "$SKIP_IDENTITY_GUARD" = "1" ]; then
  echo "identity guard: skipped by SKIP_IDENTITY_GUARD=1"
  exit 0
fi

status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  if [ "$remote_sha" = "$ZERO" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  bad=$(git log --format='%h %ae %ce' "$range" 2>/dev/null | awk -v ok="$APPROVED" '$2 != ok || $3 != ok { print }')
  if [ -n "$bad" ]; then
    echo "identity guard: these commits would publish an email other than the approved public identity:" >&2
    echo "$bad" >&2
    status=1
  fi
done

if [ "$status" != "0" ]; then
  echo "" >&2
  echo "identity guard: push refused. Make those commits again with the approved identity, or ask the owner." >&2
fi

exit "$status"
